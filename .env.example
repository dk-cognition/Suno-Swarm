# Copy to .env for local development.

SWARM_DEBUG=1
SWARM_DATABASE_URL=postgresql://swarm:swarm@localhost:5432/swarm
SWARM_REDIS_URL=redis://localhost:6379/0

# Token signing / webhook verification.
# Required — the api service refuses to start if these are unset.
# Generate unique values per environment, e.g.: openssl rand -hex 32
SWARM_JWT_SECRET=
SWARM_WEBHOOK_SECRET=
SWARM_BILLING_WEBHOOK_SECRET=

# Object storage (MinIO locally)
SWARM_S3_BUCKET=suno-swarm-artifacts
SWARM_S3_ENDPOINT=http://localhost:9000
# Required — use your local MinIO credentials or a scoped IAM key; never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Filesystem mirror of the artifact tree
SWARM_ARTIFACT_ROOT=/var/lib/swarm/artifacts

# Worker
SWARM_MODEL_DIR=/var/cache/swarm/models
SWARM_MODEL_VERSION=swarm-diffusion-2.3
SWARM_SAMPLING_STEPS=50
SWARM_API_BASE_URL=http://localhost:8000

# Frontend
VITE_API_BASE=http://localhost:8000
SWARM_SHARE_BASE_URL=http://localhost:4000
